# UE5.8 — DaDungeon (project lives in /DaDungeon subfolder)
# Patterns use **/ so they match both at root and inside DaDungeon/.

# ── Engine generated — never commit ──────────────────────────────
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/.vs/
**/.vscode/
**/.idea/

# Build artifacts
Build/
**/Build/

# Compiled binaries — covers Binaries/ but also stray dlls
*.dll
*.pdb
*.lib
*.a
*.so
*.dylib
*.exe
*.out
*.app
*.ipa

# Compiled objects
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.mod
*.lai
*.la

# Visual Studio / Rider generated
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.VC.VC.opendb
*.xcodeproj
*.xcworkspace
*.xcode.env.*
*.iobj
*.ipdb

# JetBrains Rider
.idea/

# VS Code
.vscode/

# ── UE specifics ─────────────────────────────────────────────────
# Precompiled assets / derived content
SourceArt/**/*.png
SourceArt/**/*.tga
*_BuiltData.uasset
*_BuiltData.umap

# Config generated by editor — keep defaults, ignore user overrides
# Default*.ini are tracked; editor per-user settings are not
**/Saved/**
**/Intermediate/**
**/DerivedDataCache/**

# Whitelist PakBlacklist (needed for packaging)
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# ── OS junk ──────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
