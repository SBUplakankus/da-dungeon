# UE5.8 — DaDungeon (project lives in /DaDungeon subfolder)
# Patterns use **/ so they match both at root and inside DaDungeon/.

# ── Engine generated — never commit ──────────────────────────────
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/.vs/
**/.vscode/
**/.idea/

# Build artifacts
Build/
**/Build/

# Compiled binaries — covers Binaries/ but also stray dlls
*.dll
*.pdb
*.lib
*.a
*.so
*.dylib
*.exe
*.out
*.app
*.ipa

# Compiled objects
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.mod
*.lai
*.la

# Visual Studio / Rider generated
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.VC.VC.opendb
*.xcodeproj
*.xcworkspace
*.xcode.env.*
*.iobj
*.ipdb

# JetBrains Rider
.idea/

# VS Code
.vscode/

# ── UE specifics ─────────────────────────────────────────────────
# Precompiled assets / derived content
SourceArt/**/*.png
SourceArt/**/*.tga
*_BuiltData.uasset
*_BuiltData.umap

# Config generated by editor — keep defaults, ignore user overrides
# Default*.ini are tracked; editor per-user settings are not
**/Saved/**
**/Intermediate/**
**/DerivedDataCache/**

# Whitelist PakBlacklist (needed for packaging)
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# ── Third-party / Fab marketplace content — do not commit ───────
# Quarantined under DaDungeon/Content/_ThirdParty/ (~10 GB+). Recreate via
# Fab/Epic Launcher "Add to Project" instead of cloning.
DaDungeon/Content/_ThirdParty/**
**/Content/_ThirdParty/**
**/_ThirdParty/**
!DaDungeon/Content/_ThirdParty/README.md
!**/Content/_ThirdParty/README.md
!**/_ThirdParty/README.md

# Proactive: Agora & Monolith are still downloading — if they land at
# Content/Agora/ or Content/Monolith/ (or ParagonAgora/Monolith) before
# you move them to _ThirdParty/, they are already ignored.
DaDungeon/Content/Agora/
DaDungeon/Content/Monolith/
DaDungeon/Content/ParagonAgora/
DaDungeon/Content/ParagonMonolith/
**/Content/Agora/
**/Content/Monolith/
**/Content/ParagonAgora/
**/Content/ParagonMonolith/

# Belt-and-suspenders for top-level restores (e.g. re-adding via Launcher)
DaDungeon/Content/ModularSciFiStation/
DaDungeon/Content/ParagonMinions/
DaDungeon/Content/ParagonLtBelica/
DaDungeon/Content/ParagonWraith/
DaDungeon/Content/ParagonMuriel/
DaDungeon/Content/ParagonMaleAnnouncer/
**/ModularSciFiStation/
**/ParagonMinions/
**/ParagonLtBelica/
**/ParagonWraith/
**/ParagonMuriel/
**/ParagonMaleAnnouncer/

# ── OS junk ──────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
